# Адрес бэкенда БЕЗ /api/v1 на конце. Путь /api/v1 клиент дописывает сам.
#
# Три рабочих варианта:
#   http://188.94.158.71:8000   тестовый сервер (по умолчанию)
#   http://localhost:8000       локальный бэкенд в Docker
#   (пустая строка)             тот же адрес, откуда отдан фронтенд —
#                               для деплоя, где nginx проксирует /api на бэкенд
VITE_API_BASE_URL=http://188.94.158.71:8000

# Необязательно: id городов Узбекистана через запятую.
# Нужно, пока в справочнике парков не заполнен city_name.
# Парки этих городов показывают суммы в сумах, остальные — в тенге.
VITE_UZ_CITY_IDS=
