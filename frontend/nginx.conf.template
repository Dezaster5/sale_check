# Конфигурация nginx для отдачи собранного фронтенда.
#
# Файл — шаблон: официальный образ nginx подставляет переменные окружения
# в /etc/nginx/templates/*.template при старте контейнера.
# Подставляется ${API_UPSTREAM} — адрес бэкенда.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    # Скрываем версию nginx и защищаем от кликджекинга
    server_tokens off;
    add_header X-Frame-Options       "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff"   always;
    add_header Referrer-Policy       "same-origin" always;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;

    # Загрузка Excel и крупные ответы API не должны упираться в буферы
    client_max_body_size 8m;

    # --- API проксируется на бэкенд ---
    #
    # Именно это снимает две проблемы разом:
    #   1. mixed content — бэкенд работает по http, и страница по https не может
    #      обращаться к нему напрямую. Здесь запрос уходит с сервера, а не из
    #      браузера, поэтому запрет не действует;
    #   2. CORS — для браузера запрос становится тем же происхождением.
    #
    # При таком варианте VITE_API_BASE_URL в сборке должен быть пустым.
    location /api/ {
        proxy_pass         ${API_UPSTREAM};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Выгрузка в Excel тянет все страницы подряд — таймауты с запасом
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;

        proxy_buffering off;
    }

    # Имена файлов сборки содержат хеш, поэтому кэшировать их можно надолго
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.svg {
        expires 7d;
        access_log off;
    }

    # index.html не кэшируем: иначе после выката пользователь останется
    # на старой версии со ссылками на уже удалённые файлы сборки
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }
}
